# Operator values — the only file you edit. Copy to .env and adjust.
# Everything network-related (genesis, peers, image pins) is read from the
# artifacts repo by setup.sh; nothing here changes when the network changes.

# Path to the network directory inside your clone of the artifacts repo
# (Arkiv-Network/db-chain-networks).
NETWORK_DIR=../db-chain-networks/networks/flan

# Local ports. Both bind to loopback only — they answer on this host and
# nowhere else.
EL_RPC_PORT=8545
CL_HTTP_PORT=5052
