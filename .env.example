# Operator values — the only file you edit. Copy to .env and adjust.
# Everything network-related (genesis, peers, image pins) is read from the
# artifacts directory by setup.sh; nothing here changes when the network
# changes.

# REQUIRED. The network to join, by the name the network operator's
# registry of networks lists it under (for example tiramisu). setup.sh
# clones the registry into db-chain-networks/ on the first run and reads the
# network's artifacts (genesis.json, p2p.yaml, SHA256SUMS and friends)
# from it.
NETWORK=
# Instead of NETWORK: the path to a network artifacts directory of your
# own, holding the same files. When set, NETWORK is not used.
#NETWORK_DIR=

# Local ports. Both bind to loopback only — they answer on this host and
# nowhere else.
EL_RPC_PORT=8545
CL_HTTP_PORT=5052

# Optional features. Enable by listing profile names, comma-separated:
#   tunnel   — serve your RPC through a tunnel server (settings below)
#   monitor  — on-box alerting with Uptime Kuma (setup: see the README)
#COMPOSE_PROFILES=tunnel,monitor

# Tunnel settings — used only with the tunnel profile. All five are
# written by `./marketplace.sh start-tunnel` from your agreement with
# the load balancer, which also turns the profile on; nothing to type.
#TUNNEL_SERVER_ADDR=
#TUNNEL_SERVER_PORT=
#TUNNEL_REMOTE_PORT=
#TUNNEL_AGREEMENT=
#TUNNEL_TOKEN=

# Marketplace settings — used only by marketplace.sh (see the README).
# The load balancer's and the settle key's addresses ship with the
# distribution; set these only for a private deployment with its own
# load balancer. The previous settle addresses, comma-separated, are
# the keys that paid before a rotation: their receipts are payouts too.
# Left empty, each of these uses the shipped value, so an empty
# SETTLE_PREVIOUS_ADDRESSES means the shipped list, not none.
#LB_ADDRESS=
#SETTLE_ADDRESS=
#SETTLE_PREVIOUS_ADDRESSES=

# Local port of the tunnel client's status endpoint (loopback only).
#TUNNEL_STATUS_PORT=7400

# Monitoring settings — used only with the monitor profile.
# Local port of Uptime Kuma's web UI (loopback only).
#MONITOR_UI_PORT=3001
